[Unit]
Description=Slipway pre-registered evaluation batch (protocol cadence 10 min)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=slipway
Group=slipway
WorkingDirectory=/opt/slipway/app
EnvironmentFile=/opt/slipway/app/tape.env
ExecStart=/usr/bin/node /opt/slipway/app/cli.mjs eval
Nice=-5
CPUWeight=1000
IOWeight=1000
MemoryMax=700M
TimeoutStartSec=540
