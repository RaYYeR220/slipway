[Unit]
Description=Slipway grade due forecasts against the recorded book, publish derived/track-record.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=slipway
Group=slipway
WorkingDirectory=/opt/slipway/app
EnvironmentFile=/opt/slipway/app/tape.env
ExecStart=/usr/bin/node /opt/slipway/app/cli.mjs grade
Nice=10
MemoryMax=700M
TimeoutStartSec=1200
