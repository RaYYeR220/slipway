{
  "name": "@slipway/agent",
  "version": "0.1.0",
  "description": "Language and integration surface for Slipway: the desk service, LLM tools and agent, HTTP route handlers and the slot renderer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "eval:lui": "tsx eval/lui-run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.63",
    "@slipway/bitget": "workspace:^",
    "@slipway/core": "workspace:^",
    "@slipway/sdk": "workspace:^",
    "ai": "^7.0.128",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.22"
  }
}
