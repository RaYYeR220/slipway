{
  "name": "slipway-lui-v1",
  "registered": "2026-10-06",
  "protocol": "Each case is a scripted multi-turn conversation run once, in order, against the live desk (live Bitget data) with the production system prompt and tools. The answer key below was written before any live run. A turn's score is the share of its checks that pass; a case's score is the mean of its turns; the headline score is the mean over cases. A turn is strict-correct when every check passes. Checks: calls.mustInclude / mustNotInclude (tool names called in the turn), intent (fields of the turn's last price_options or build_plan call, resolved by the desk: symbol, side, notionalUsd within 1%, qty exact, venues as a set, urgency, holdHorizonHours within 15%, deadline day / hours from now), clarify (no order tool called and the reply asks a question), noNumerals (the rendered reply has no masked figure), citesSlot (the reply cites a slot whose name matches), ticketsIffAllow (issue_tickets called if and only if the conversation's latest plan verdict is ALLOW), lang (reply script), patch (fields of a propose_profile_update call), any (at least one listed alternative passes in full); every turn also checks replied (non-empty reply).",
  "profiles": {
    "default": {
      "name": "default",
      "urgency": "normal",
      "costCapBps": 25,
      "maxParticipation": 0.1,
      "allowPerp": true,
      "maxLeverage": 1,
      "avoidSessions": [],
      "avoidEvents": true
    },
    "strict_cap": {
      "name": "strict_cap",
      "urgency": "normal",
      "costCapBps": 3,
      "maxParticipation": 0.1,
      "allowPerp": true,
      "maxLeverage": 1,
      "avoidSessions": [],
      "avoidEvents": true
    }
  },
  "cases": [
    {
      "id": "L01",
      "kind": "full-task",
      "profile": "default",
      "turns": [
        {
          "user": "I want $40k of NVDA before Thursday, no perps, I'm patient",
          "expect": {
            "calls": { "mustInclude": ["price_options"], "mustNotInclude": ["build_plan", "issue_tickets"] },
            "intent": {
              "tool": "price_options",
              "symbol": "NVDA",
              "side": "buy",
              "notionalUsd": 40000,
              "venues": ["rtoken"],
              "urgency": "patient",
              "deadlineDay": "thursday"
            },
            "noNumerals": true,
            "citesSlot": "\\.best\\."
          }
        },
        {
          "user": "go with the best one",
          "expect": {
            "calls": { "mustInclude": ["build_plan"], "mustNotInclude": ["issue_tickets"] },
            "intent": { "tool": "build_plan", "symbol": "NVDA", "notionalUsd": 40000, "venues": ["rtoken"] },
            "noNumerals": true
          }
        },
        {
          "user": "confirmed — issue the tickets",
          "expect": {
            "ticketsIffAllow": true,
            "calls": { "mustNotInclude": ["price_options"] },
            "noNumerals": true
          }
        }
      ]
    },
    {
      "id": "L02",
      "kind": "terse",
      "profile": "default",
      "turns": [
        {
          "user": "TSLA sell 50 sh",
          "expect": {
            "calls": { "mustInclude": ["price_options"] },
            "intent": { "tool": "price_options", "symbol": "TSLA", "side": "sell", "qty": 50 },
            "noNumerals": true
          }
        },
        {
          "user": "cheaper?",
          "expect": { "calls": { "mustNotInclude": ["build_plan", "issue_tickets"] }, "noNumerals": true }
        }
      ]
    },
    {
      "id": "L03",
      "kind": "typo",
      "profile": "default",
      "turns": [
        {
          "user": "buy 15k nvdia asap pls",
          "expect": {
            "calls": { "mustInclude": ["price_options"] },
            "intent": {
              "tool": "price_options",
              "symbol": "NVDA",
              "side": "buy",
              "notionalUsd": 15000,
              "urgency": "urgent"
            },
            "noNumerals": true
          }
        }
      ]
    },
    {
      "id": "L04",
      "kind": "vague",
      "profile": "default",
      "turns": [
        { "user": "I want some Nvidia", "expect": { "clarify": true, "noNumerals": true } },
        {
          "user": "buy, about $20k",
          "expect": {
            "calls": { "mustInclude": ["price_options"] },
            "intent": { "tool": "price_options", "symbol": "NVDA", "side": "buy", "notionalUsd": 20000 },
            "noNumerals": true
          }
        }
      ]
    },
    {
      "id": "L05",
      "kind": "vague",
      "profile": "default",
      "turns": [
        { "user": "what's the smartest way to trade this", "expect": { "clarify": true, "noNumerals": true } }
      ]
    },
    {
      "id": "L06",
      "kind": "follow-up",
      "profile": "default",
      "turns": [
        {
          "user": "Price a $25k AAPL buy for me.",
          "expect": {
            "calls": { "mustInclude": ["price_options"] },
            "intent": { "tool": "price_options", "symbol": "AAPL", "side": "buy", "notionalUsd": 25000 },
            "noNumerals": true
          }
        },
        {
          "user": "no perps",
          "expect": {
            "calls": { "mustInclude": ["price_options"] },
            "intent": {
              "tool": "price_options",
              "symbol": "AAPL",
              "side": "buy",
              "notionalUsd": 25000,
              "venues": ["rtoken"]
