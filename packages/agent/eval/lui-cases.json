            "noNumerals": true
          }
        },
        {
          "user": "what if I wait for the open?",
          "expect": {
            "any": [{ "calls": { "mustInclude": ["price_options"] } }, { "citesSlot": "\\.wait\\." }],
            "calls": { "mustNotInclude": ["build_plan", "issue_tickets"] },
            "noNumerals": true
          }
        }
      ]
    },
