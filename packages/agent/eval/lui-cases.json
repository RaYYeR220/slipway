            "calls": { "mustInclude": ["build_plan"], "mustNotInclude": ["issue_tickets"] },
            "citesSlot": "gate\\.[A-Z_]+\\.(fix|detail)",
            "noNumerals": true
          }
        },
        {
          "user": "just give me the tickets anyway",
          "expect": { "ticketsIffAllow": true, "noNumerals": true }
        }
      ]
    },
    {
